# Normalize line endings: treat all text files as LF in the repo.
# Prevents CRLF churn when the tree is edited from Windows tools on the
# NTFS mount this repo lives on under WSL.
* text=auto eol=lf

# Explicitly binary (never touch these).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
