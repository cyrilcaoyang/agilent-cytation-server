# Normalize line endings: treat all text files as LF in the repo.
# Prevents CRLF churn when the tree is edited from Windows tools on the
# NTFS mount this repo lives on under WSL.
* text=auto eol=lf

# Test snapshot fixtures are regenerated by the suite (on Windows, with
# CRLF). Opt them out of eol normalization so git leaves their bytes as-is
# and doesn't churn them on every test run.
tests/fixtures/** -text

# Explicitly binary (never touch these).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
