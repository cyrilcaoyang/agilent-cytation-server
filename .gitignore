# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/

# Machine-specific config (use config.example.toml as template)
config.toml

# Persisted PyLabRobot Deck snapshot (Phase 2 — sample tracking)
state.json

